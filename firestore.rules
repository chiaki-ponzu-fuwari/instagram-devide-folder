rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isUidDeletionLocked(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/accountDeletionLocks/$(uid));
    }

    function isDeletionUnlocked(uid) {
      return uid is string && !isUidDeletionLocked(uid);
    }

    function canWriteTeamData() {
      return signedIn() && isDeletionUnlocked(request.auth.uid);
    }

    function hasUnlockedIdentity(data) {
      return (!data.keys().hasAny(['uid']) || data.uid == null || isDeletionUnlocked(data.uid))
        && (!data.keys().hasAny(['memberUid']) || data.memberUid == null || isDeletionUnlocked(data.memberUid))
        && (!data.keys().hasAny(['invitedUid']) || data.invitedUid == null || isDeletionUnlocked(data.invitedUid))
        && (!data.keys().hasAny(['createdBy']) || data.createdBy == null || isDeletionUnlocked(data.createdBy))
        && (!data.keys().hasAny(['updatedBy']) || data.updatedBy == null || isDeletionUnlocked(data.updatedBy))
        && (!data.keys().hasAny(['deletedBy']) || data.deletedBy == null || isDeletionUnlocked(data.deletedBy))
        && (!data.keys().hasAny(['ownerUid']) || data.ownerUid == null || isDeletionUnlocked(data.ownerUid))
        && (!data.keys().hasAny(['approvedBy']) || data.approvedBy == null || isDeletionUnlocked(data.approvedBy))
        && (!data.keys().hasAny(['actorUid']) || data.actorUid == null || isDeletionUnlocked(data.actorUid))
        && (!data.keys().hasAny(['targetUid']) || data.targetUid == null || isDeletionUnlocked(data.targetUid));
    }

    function uidArrayIsMemberSubset(data, field, memberUids) {
      return !data.keys().hasAny([field])
        || (data[field] is list
          && data[field].toSet().size() == data[field].size()
          && data[field].toSet().difference(memberUids.toSet()).size() == 0);
    }

    function settingsUidArraysAreMembers(settings, memberUids) {
      return settings is map
        && memberUids is list
        && uidArrayIsMemberSubset(settings, 'assignOwnerUids', memberUids)
        && uidArrayIsMemberSubset(settings, 'adminUids', memberUids)
        && uidArrayIsMemberSubset(settings, 'ownerUids', memberUids)
        && uidArrayIsMemberSubset(settings, 'managerUids', memberUids)
        && uidArrayIsMemberSubset(settings, 'assignedUids', memberUids)
        && uidArrayIsMemberSubset(settings, 'assigneeUids', memberUids);
    }

    function childIdentityIsValid(teamId, data) {
      let members = getAfter(teamPath(teamId)).data.memberUids;
      return hasUnlockedIdentity(data)
        && (!data.keys().hasAny([
            'assignedUids', 'assigneeUids', 'assignOwnerUids', 'memberUids',
            'adminUids', 'ownerUids', 'managerUids'
          ])
          || (members is list
            && uidArrayIsMemberSubset(data, 'assignedUids', members)
            && uidArrayIsMemberSubset(data, 'assigneeUids', members)
            && uidArrayIsMemberSubset(data, 'assignOwnerUids', members)
            && uidArrayIsMemberSubset(data, 'memberUids', members)
            && uidArrayIsMemberSubset(data, 'adminUids', members)
            && uidArrayIsMemberSubset(data, 'ownerUids', members)
            && uidArrayIsMemberSubset(data, 'managerUids', members)));
    }

    function initialUidArrayIsCreator(data, field) {
      return !data.keys().hasAny([field])
        || (data[field] is list
          && data[field].size() == 1
          && data[field][0] == request.auth.uid);
    }

    function initialTeamIdentityIsValid(teamId, data) {
      return data.memberUids is list
        && data.memberUids.size() == 1
        && data.memberUids[0] == request.auth.uid
        && initialUidArrayIsCreator(data, 'adminUids')
        && initialUidArrayIsCreator(data, 'ownerUids')
        && childIdentityIsValid(teamId, data);
    }

    function legacyTeamUidArrayIsStable(field) {
      return !request.resource.data.keys().hasAny([field])
        || (resource.data.keys().hasAll([field])
          && request.resource.data[field] == resource.data[field]);
    }

    function teamRootUidArraysAreStable() {
      return legacyTeamUidArrayIsStable('assignedUids')
        && legacyTeamUidArrayIsStable('assigneeUids')
        && legacyTeamUidArrayIsStable('assignOwnerUids')
        && legacyTeamUidArrayIsStable('adminUids')
        && legacyTeamUidArrayIsStable('ownerUids')
        && legacyTeamUidArrayIsStable('managerUids');
    }

    function isValidTeamInviteCodeCreate() {
      return request.resource.data.keys().hasOnly([
        'code', 'teamId', 'inviteId', 'teamName', 'createdBy',
        'createdAt', 'disabledAt'
      ]);
    }

    function isValidJoinRequestCreate() {
      return request.resource.data.keys().hasOnly([
        'uid', 'inviteId', 'teamId', 'teamName', 'displayName', 'email',
        'status', 'createdAt', 'updatedAt'
      ]);
    }

    function stableTeamOwners() {
      return request.resource.data.createdBy == resource.data.createdBy
        && ((!resource.data.keys().hasAny(['ownerUid'])
            && !request.resource.data.keys().hasAny(['ownerUid']))
          || (resource.data.keys().hasAll(['ownerUid'])
            && request.resource.data.keys().hasAll(['ownerUid'])
            && request.resource.data.ownerUid == resource.data.ownerUid));
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function memberPath(teamId, uid) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(uid);
    }

    function isValidTeamMemberUidLists(teamId, before, after) {
      let additions = after.toSet().difference(before.toSet());
      let addedUid = after.size() > 0 ? after[after.size() - 1] : '';
      return before is list
        && after is list
        && after.toSet().size() == after.size()
        && (additions.size() == 0
          || (additions.size() == 1
            && additions.hasOnly([addedUid])
            && isDeletionUnlocked(addedUid)
            && existsAfter(memberPath(teamId, addedUid))
            && getAfter(memberPath(teamId, addedUid)).data.uid == addedUid
            && getAfter(memberPath(teamId, addedUid)).data.status == 'active'));
    }

    function isValidTeamMemberUidUpdate(teamId) {
      return (!resource.data.keys().hasAny(['memberUids'])
          && !request.resource.data.keys().hasAny(['memberUids']))
        || (resource.data.keys().hasAll(['memberUids'])
          && request.resource.data.keys().hasAll(['memberUids'])
          && isValidTeamMemberUidLists(
            teamId, resource.data.memberUids, request.resource.data.memberUids));
    }

    function embeddedSettingsUidsAreMembers(data) {
      return !data.keys().hasAny(['settings'])
        || !data.keys().hasAny(['memberUids'])
        || settingsUidArraysAreMembers(data.settings, data.memberUids);
    }

    function projectAssigneesAreMembers(teamId, data) {
      let members = getAfter(teamPath(teamId)).data.memberUids;
      return !data.keys().hasAny(['assignedUids'])
        || (members is list
          && data.assignedUids is list
          && data.assignedUids.toSet().size() == data.assignedUids.size()
          && data.assignedUids.toSet().difference(members.toSet()).size() == 0);
    }

    function memberDoc(teamId) {
      return get(memberPath(teamId, request.auth.uid));
    }

    function isApprovedMember(teamId) {
      return signedIn()
        && exists(memberPath(teamId, request.auth.uid))
        && memberDoc(teamId).data.status == 'active';
    }

    function isListedMember(teamId) {
      return signedIn()
        && exists(teamPath(teamId))
        && get(teamPath(teamId)).data.memberUids.hasAny([request.auth.uid]);
    }

    function isAdmin(teamId) {
      return isApprovedMember(teamId) && memberDoc(teamId).data.role == 'admin';
    }

    function isTeamCreator(teamId) {
      return signedIn()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
    }

    function canManageTeam(teamId) {
      return isAdmin(teamId) || isTeamCreator(teamId);
    }

    function isMigrationReady(teamId) {
      return exists(teamPath(teamId))
        && get(teamPath(teamId)).data.securitySchemaVersion == 2
        && get(teamPath(teamId)).data.securityMigrationState == 'ready';
    }

    // Administrators and creators may migrate locked data. Everyone else is
    // denied workspace access until the v2 migration is explicitly ready.
    function canReadReadyPublicTeam(teamId) {
      return canManageTeam(teamId)
        || (isApprovedMember(teamId) && isMigrationReady(teamId));
    }

    function hasKnownSettings(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId)/settings/main)
        && get(/databases/$(database)/documents/teams/$(teamId)/settings/main).data.memberEmailVisibility in ['self', 'all_members', 'admin_only']
        && get(/databases/$(database)/documents/teams/$(teamId)/settings/main).data.memberNoteVisibility in ['self', 'all_members', 'admin_only']
        && get(/databases/$(database)/documents/teams/$(teamId)/settings/main).data.rewardVisibility in ['self', 'all_members', 'admin_only']
        && get(/databases/$(database)/documents/teams/$(teamId)/settings/main).data.memberPayoutVisibility in ['self', 'all_members', 'admin_only'];
    }

    function canReadPrivateField(teamId, uid, fieldName) {
      return canManageTeam(teamId)
        || (isMigrationReady(teamId) && isApprovedMember(teamId)
          && hasKnownSettings(teamId)
          && (isSelf(uid)
            || get(/databases/$(database)/documents/teams/$(teamId)/settings/main).data[fieldName] == 'all_members'));
    }

    function canReadReward(teamId, uid) {
      return canManageTeam(teamId)
        || (isMigrationReady(teamId) && isApprovedMember(teamId)
          && hasKnownSettings(teamId)
          && (isSelf(uid)
            || get(/databases/$(database)/documents/teams/$(teamId)/settings/main).data.rewardVisibility == 'all_members'));
    }

    function canReadRewardTotal(teamId) {
      return canManageTeam(teamId)
        || (isMigrationReady(teamId) && isApprovedMember(teamId)
          && hasKnownSettings(teamId)
          && get(/databases/$(database)/documents/teams/$(teamId)/settings/main).data.rewardVisibility == 'all_members');
    }

    function validRewardTotal(projectId) {
      return request.resource.data.keys().hasOnly(['projectId', 'rewardYen', 'updatedAt', 'updatedBy'])
        && request.resource.data.projectId == projectId
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validRewardShare(projectId, uid) {
      return request.resource.data.keys().hasOnly(['projectId', 'uid', 'rewardYen', 'updatedAt', 'updatedBy'])
        && request.resource.data.projectId == projectId
        && request.resource.data.uid == uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validProjectCost(projectId) {
      return request.resource.data.keys().hasOnly(['projectId', 'costYen', 'updatedAt', 'updatedBy'])
        && request.resource.data.projectId == projectId
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validPayout(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'payoutName', 'payoutAccount', 'payoutBankCode',
          'payoutBankName', 'payoutBranchName', 'payoutBranchCode',
          'payoutAccountType', 'payoutAccountNumber', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validPublicMember(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'role', 'status', 'displayName', 'photoURL',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validPublicProject(projectId) {
      return request.resource.data.keys().hasOnly([
          'id', 'name', 'status', 'assignedUids', 'completedAt',
          'parentProjectId', 'revision', 'tombstone', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.id == projectId
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validPublicAccount(accountId) {
      return request.resource.data.keys().hasOnly([
          'id', 'name', 'username', 'folderId', 'projectId', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.id == accountId
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function hasPublicMemberShape() {
      return resource.data.keys().hasOnly([
        'uid', 'role', 'status', 'displayName', 'photoURL',
        'createdAt', 'updatedAt', 'updatedBy'
      ]);
    }

    function hasPublicProjectShape() {
      return resource.data.keys().hasOnly([
        'id', 'name', 'status', 'assignedUids', 'completedAt',
        'parentProjectId', 'revision', 'tombstone', 'createdAt', 'updatedAt', 'updatedBy'
      ]);
    }

    function hasPublicAccountShape() {
      return resource.data.keys().hasOnly([
        'id', 'name', 'username', 'folderId', 'projectId', 'createdAt', 'updatedAt', 'updatedBy'
      ]);
    }

    function canReadPayout(teamId, uid) {
      return canManageTeam(teamId)
        || (isMigrationReady(teamId) && isApprovedMember(teamId)
          && hasKnownSettings(teamId)
          && (isSelf(uid)
            || get(/databases/$(database)/documents/teams/$(teamId)/settings/main).data.memberPayoutVisibility == 'all_members'));
    }

    function isProjectActivityAction(action) {
      return action in ['createProject', 'markDelivered', 'markCompleted', 'deleteProject'];
    }

    function isValidProjectActivity() {
      return isProjectActivityAction(request.resource.data.action)
        && request.resource.data.keys().hasOnly([
          'action', 'text', 'coreText', 'actorUid', 'actorName',
          'targetName', 'projectId', 'createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0
        && request.resource.data.actorName.size() <= 80
        && request.resource.data.targetName is string
        && request.resource.data.targetName.size() > 0
        && request.resource.data.targetName.size() <= 120
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && request.resource.data.projectId.size() <= 120
        && request.resource.data.coreText is string
        && request.resource.data.coreText.size() <= 240
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 320
        && request.resource.data.createdAt == request.time;
    }

    function isValidLegacyActivity(teamId) {
      return request.resource.data.keys().hasOnly([
          'action', 'text', 'coreText', 'actorUid', 'actorName',
          'targetName', 'createdAt'
        ])
        && request.resource.data.action in ['createTeam', 'joinTeam', 'leaveTeam', 'removeMember']
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.action == 'joinTeam' && canManageTeam(teamId))
          || (request.resource.data.actorUid == request.auth.uid));
    }

    function isSafeSelfMemberUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'email',
        'payoutName',
        'payoutAccount',
        'payoutBankCode',
        'payoutBankName',
        'payoutBranchName',
        'payoutBranchCode',
        'payoutAccountType',
        'payoutAccountNumber',
        'note',
        'updatedAt',
        'updatedBy',
      ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /accountDeletionJobs/{jobId} {
      allow read, write: if false;
    }

    match /accountDeletionLocks/{uid} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && isDeletionUnlocked(uid);
      allow delete: if false;

      match /folders/{folderId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && isDeletionUnlocked(uid);
        allow delete: if false;
      }

      match /accounts/{accountId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && isDeletionUnlocked(uid);
        allow delete: if false;
      }

      match /projects/{projectId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && isDeletionUnlocked(uid);
        allow delete: if false;
      }

      match /templates/{templateId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && isDeletionUnlocked(uid);
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && isDeletionUnlocked(uid);
        allow delete: if false;
      }
    }

    match /teamInviteCodes/{code} {
      allow get: if signedIn() && resource.data.disabledAt == null;
      allow list: if false;
      allow create: if signedIn()
        && canWriteTeamData()
        && hasUnlockedIdentity(request.resource.data)
        && isValidTeamInviteCodeCreate()
        && request.resource.data.code == code
        && request.resource.data.teamId is string
        && request.resource.data.inviteId is string
        && request.resource.data.createdBy == request.auth.uid
        && canManageTeam(request.resource.data.teamId);
      allow update: if signedIn()
        && canWriteTeamData()
        && hasUnlockedIdentity(request.resource.data)
        && isValidTeamInviteCodeCreate()
        && request.resource.data.code == code
        && request.resource.data.teamId is string
        && request.resource.data.inviteId is string
        && request.resource.data.createdBy == request.auth.uid
        && canManageTeam(request.resource.data.teamId);
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow create: if signedIn()
        && canWriteTeamData()
        && hasUnlockedIdentity(request.resource.data)
        && initialTeamIdentityIsValid(teamId, request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.deletedAt == null
        && request.resource.data.rewardVisibility in ['admin_only', 'all_members', 'selected_members'];
      allow read: if (signedIn() && resource.data.memberUids.hasAny([request.auth.uid])) || isApprovedMember(teamId) || isTeamCreator(teamId);
      allow update: if canWriteTeamData()
        && canManageTeam(teamId)
        && hasUnlockedIdentity(request.resource.data)
        && stableTeamOwners()
        && teamRootUidArraysAreStable()
        && isValidTeamMemberUidUpdate(teamId)
        && embeddedSettingsUidsAreMembers(request.resource.data);
      allow delete: if false;

      match /members/{uid} {
        allow read: if canManageTeam(teamId)
          || (isApprovedMember(teamId) && isMigrationReady(teamId) && hasPublicMemberShape());
        allow create: if canWriteTeamData() && isDeletionUnlocked(uid) && ((canManageTeam(teamId) && validPublicMember(uid))
          || (signedIn()
            && uid == request.auth.uid
            && isTeamCreator(teamId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'active'
            && validPublicMember(uid)));
        allow update: if canWriteTeamData() && isDeletionUnlocked(uid) && ((canManageTeam(teamId) && validPublicMember(uid))
          || (isMigrationReady(teamId) && isSelf(uid) && validPublicMember(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status));
        allow delete: if canWriteTeamData() && (canManageTeam(teamId)
          || (isSelf(uid) && resource.data.role != 'admin'));
      }

      // 振込先(機微情報)は本人・管理者、またはチーム設定で公開された承認済みメンバーだけ読める
      match /payouts/{uid} {
        allow read: if canReadPayout(teamId, uid);
        allow create, update: if canWriteTeamData() && isDeletionUnlocked(uid) && (canManageTeam(teamId)
          || (isMigrationReady(teamId) && isApprovedMember(teamId) && isSelf(uid)))
          && validPayout(uid);
        allow delete: if canWriteTeamData() && (canManageTeam(teamId)
          || (isMigrationReady(teamId) && isApprovedMember(teamId) && isSelf(uid)));
      }

      // Private profile fields are intentionally separate from public member docs.
      match /memberEmails/{uid} {
        allow read: if canReadPrivateField(teamId, uid, 'memberEmailVisibility');
        allow create, update: if canWriteTeamData() && isDeletionUnlocked(uid) && (canManageTeam(teamId)
          || (isMigrationReady(teamId) && isApprovedMember(teamId) && isSelf(uid)))
          && request.resource.data.keys().hasOnly(['uid', 'email', 'updatedAt', 'updatedBy'])
          && request.resource.data.uid == uid && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if canWriteTeamData() && (canManageTeam(teamId)
          || (isMigrationReady(teamId) && isApprovedMember(teamId) && isSelf(uid)));
      }

      match /memberNotes/{uid} {
        allow read: if canReadPrivateField(teamId, uid, 'memberNoteVisibility');
        allow create, update: if canWriteTeamData() && isDeletionUnlocked(uid) && (canManageTeam(teamId)
          || (isMigrationReady(teamId) && isApprovedMember(teamId) && isSelf(uid)))
          && request.resource.data.keys().hasOnly(['uid', 'note', 'updatedAt', 'updatedBy'])
          && request.resource.data.uid == uid && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if canWriteTeamData() && (canManageTeam(teamId)
          || (isMigrationReady(teamId) && isApprovedMember(teamId) && isSelf(uid)));
      }

      match /folders/{folderId} {
        allow read: if canReadReadyPublicTeam(teamId);
        allow create, update: if canWriteTeamData() && canReadReadyPublicTeam(teamId)
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /accounts/{accountId} {
        allow read: if canManageTeam(teamId)
          || (isApprovedMember(teamId) && isMigrationReady(teamId) && hasPublicAccountShape());
        allow create, update: if canWriteTeamData() && canReadReadyPublicTeam(teamId)
          && validPublicAccount(accountId) && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /projects/{projectId} {
        allow read: if canManageTeam(teamId)
          || (isApprovedMember(teamId) && isMigrationReady(teamId) && hasPublicProjectShape());
        allow create, update: if canWriteTeamData()
          && canReadReadyPublicTeam(teamId)
          && validPublicProject(projectId)
          && projectAssigneesAreMembers(teamId, request.resource.data)
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /projectRewardTotals/{projectId} {
        allow read: if canReadRewardTotal(teamId);
        allow create, update: if canWriteTeamData() && canManageTeam(teamId)
          && validRewardTotal(projectId) && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if canWriteTeamData() && canManageTeam(teamId);
      }

      match /projectRewardShares/{shareId} {
        allow read: if canReadReward(teamId, resource.data.uid);
        allow create, update: if canWriteTeamData() && canManageTeam(teamId)
          && hasUnlockedIdentity(request.resource.data)
          && shareId == request.resource.data.projectId + '_' + request.resource.data.uid
          && validRewardShare(request.resource.data.projectId, request.resource.data.uid);
        allow delete: if canWriteTeamData() && canManageTeam(teamId);
      }

      match /projectCosts/{projectId} {
        allow read: if canManageTeam(teamId);
        allow create, update: if canWriteTeamData() && canManageTeam(teamId)
          && validProjectCost(projectId) && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if canWriteTeamData() && canManageTeam(teamId);
      }

      match /templates/{templateId} {
        allow read: if canReadReadyPublicTeam(teamId);
        allow create, update: if canWriteTeamData() && canReadReadyPublicTeam(teamId)
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if canManageTeam(teamId);
        allow create, update: if canWriteTeamData()
          && canManageTeam(teamId)
          && settingsUidArraysAreMembers(request.resource.data, getAfter(teamPath(teamId)).data.memberUids)
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /activity/{activityId} {
        allow read: if canReadReadyPublicTeam(teamId);
        allow create: if canWriteTeamData() && canReadReadyPublicTeam(teamId)
          && (isValidProjectActivity() || isValidLegacyActivity(teamId))
          && childIdentityIsValid(teamId, request.resource.data);
        allow update, delete: if false;
      }

      match /invites/{inviteId} {
        allow read: if canManageTeam(teamId);
        allow create, update: if canWriteTeamData() && canManageTeam(teamId)
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /joinRequests/{requestId} {
        allow create: if signedIn()
          && isDeletionUnlocked(request.auth.uid)
          && isValidJoinRequestCreate()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && exists(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId))
          && get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId)).data.disabledAt == null;
        allow read: if canManageTeam(teamId) || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if canWriteTeamData() && canManageTeam(teamId)
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }
    }

    // collectionGroup query support: allow user to read their own joinRequests across teams
    match /{path=**}/joinRequests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // collectionGroup query support: allow user to find their own membership docs
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
