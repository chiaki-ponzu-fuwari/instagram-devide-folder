rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isUidDeletionLocked(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/accountDeletionLocks/$(uid));
    }

    function isDeletionUnlocked(uid) {
      return uid is string && !isUidDeletionLocked(uid);
    }

    function canWriteTeamData() {
      return signedIn() && isDeletionUnlocked(request.auth.uid);
    }

    function hasUnlockedIdentity(data) {
      return (!data.keys().hasAny(['uid']) || data.uid == null || isDeletionUnlocked(data.uid))
        && (!data.keys().hasAny(['memberUid']) || data.memberUid == null || isDeletionUnlocked(data.memberUid))
        && (!data.keys().hasAny(['invitedUid']) || data.invitedUid == null || isDeletionUnlocked(data.invitedUid))
        && (!data.keys().hasAny(['createdBy']) || data.createdBy == null || isDeletionUnlocked(data.createdBy))
        && (!data.keys().hasAny(['updatedBy']) || data.updatedBy == null || isDeletionUnlocked(data.updatedBy))
        && (!data.keys().hasAny(['deletedBy']) || data.deletedBy == null || isDeletionUnlocked(data.deletedBy))
        && (!data.keys().hasAny(['ownerUid']) || data.ownerUid == null || isDeletionUnlocked(data.ownerUid))
        && (!data.keys().hasAny(['approvedBy']) || data.approvedBy == null || isDeletionUnlocked(data.approvedBy))
        && (!data.keys().hasAny(['actorUid']) || data.actorUid == null || isDeletionUnlocked(data.actorUid))
        && (!data.keys().hasAny(['targetUid']) || data.targetUid == null || isDeletionUnlocked(data.targetUid));
    }

    function uidArrayIsMemberSubset(data, field, memberUids) {
      return !data.keys().hasAny([field])
        || (data[field] is list
          && data[field].toSet().size() == data[field].size()
          && data[field].toSet().difference(memberUids.toSet()).size() == 0);
    }

    function settingsUidArraysAreMembers(settings, memberUids) {
      return settings is map
        && memberUids is list
        && uidArrayIsMemberSubset(settings, 'assignOwnerUids', memberUids)
        && uidArrayIsMemberSubset(settings, 'adminUids', memberUids)
        && uidArrayIsMemberSubset(settings, 'ownerUids', memberUids)
        && uidArrayIsMemberSubset(settings, 'managerUids', memberUids)
        && uidArrayIsMemberSubset(settings, 'assignedUids', memberUids)
        && uidArrayIsMemberSubset(settings, 'assigneeUids', memberUids);
    }

    function childIdentityIsValid(teamId, data) {
      let members = getAfter(teamPath(teamId)).data.memberUids;
      return hasUnlockedIdentity(data)
        && (!data.keys().hasAny([
            'assignedUids', 'assigneeUids', 'assignOwnerUids', 'memberUids',
            'adminUids', 'ownerUids', 'managerUids'
          ])
          || (members is list
            && uidArrayIsMemberSubset(data, 'assignedUids', members)
            && uidArrayIsMemberSubset(data, 'assigneeUids', members)
            && uidArrayIsMemberSubset(data, 'assignOwnerUids', members)
            && uidArrayIsMemberSubset(data, 'memberUids', members)
            && uidArrayIsMemberSubset(data, 'adminUids', members)
            && uidArrayIsMemberSubset(data, 'ownerUids', members)
            && uidArrayIsMemberSubset(data, 'managerUids', members)));
    }

    function initialUidArrayIsCreator(data, field) {
      return !data.keys().hasAny([field])
        || (data[field] is list
          && data[field].size() == 1
          && data[field][0] == request.auth.uid);
    }

    function initialTeamIdentityIsValid(teamId, data) {
      return data.memberUids is list
        && data.memberUids.size() == 1
        && data.memberUids[0] == request.auth.uid
        && initialUidArrayIsCreator(data, 'adminUids')
        && initialUidArrayIsCreator(data, 'ownerUids')
        && childIdentityIsValid(teamId, data);
    }

    function legacyTeamUidArrayIsStable(field) {
      return !request.resource.data.keys().hasAny([field])
        || (resource.data.keys().hasAll([field])
          && request.resource.data[field] == resource.data[field]);
    }

    function teamRootUidArraysAreStable() {
      return legacyTeamUidArrayIsStable('assignedUids')
        && legacyTeamUidArrayIsStable('assigneeUids')
        && legacyTeamUidArrayIsStable('assignOwnerUids')
        && legacyTeamUidArrayIsStable('adminUids')
        && legacyTeamUidArrayIsStable('ownerUids')
        && legacyTeamUidArrayIsStable('managerUids');
    }

    function isValidTeamInviteCodeCreate() {
      return request.resource.data.keys().hasOnly([
        'code', 'teamId', 'inviteId', 'teamName', 'createdBy',
        'createdAt', 'disabledAt'
      ]);
    }

    function isValidJoinRequestCreate() {
      return request.resource.data.keys().hasOnly([
        'uid', 'inviteId', 'teamId', 'teamName', 'displayName', 'email',
        'status', 'createdAt', 'updatedAt'
      ]);
    }

    function stableTeamOwners() {
      return request.resource.data.createdBy == resource.data.createdBy
        && ((!resource.data.keys().hasAny(['ownerUid'])
            && !request.resource.data.keys().hasAny(['ownerUid']))
          || (resource.data.keys().hasAll(['ownerUid'])
            && request.resource.data.keys().hasAll(['ownerUid'])
            && request.resource.data.ownerUid == resource.data.ownerUid));
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function memberPath(teamId, uid) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(uid);
    }

    function isValidTeamMemberUidLists(teamId, before, after) {
      let additions = after.toSet().difference(before.toSet());
      let addedUid = after.size() > 0 ? after[after.size() - 1] : '';
      return before is list
        && after is list
        && after.toSet().size() == after.size()
        && (additions.size() == 0
          || (additions.size() == 1
            && additions.hasOnly([addedUid])
            && isDeletionUnlocked(addedUid)
            && existsAfter(memberPath(teamId, addedUid))
            && getAfter(memberPath(teamId, addedUid)).data.uid == addedUid
            && getAfter(memberPath(teamId, addedUid)).data.status == 'active'));
    }

    function isValidTeamMemberUidUpdate(teamId) {
      return (!resource.data.keys().hasAny(['memberUids'])
          && !request.resource.data.keys().hasAny(['memberUids']))
        || (resource.data.keys().hasAll(['memberUids'])
          && request.resource.data.keys().hasAll(['memberUids'])
          && isValidTeamMemberUidLists(
            teamId, resource.data.memberUids, request.resource.data.memberUids));
    }

    function embeddedSettingsUidsAreMembers(data) {
      return !data.keys().hasAny(['settings'])
        || !data.keys().hasAny(['memberUids'])
        || settingsUidArraysAreMembers(data.settings, data.memberUids);
    }

    function projectAssigneesAreMembers(teamId, data) {
      let members = getAfter(teamPath(teamId)).data.memberUids;
      return members is list
        && data.assignedUids is list
        && data.assignedUids.toSet().size() == data.assignedUids.size()
        && data.assignedUids.toSet().difference(members.toSet()).size() == 0;
    }

    function memberDoc(teamId) {
      return get(memberPath(teamId, request.auth.uid));
    }

    function isApprovedMember(teamId) {
      return signedIn()
        && exists(memberPath(teamId, request.auth.uid))
        && memberDoc(teamId).data.status == 'active';
    }

    function isListedMember(teamId) {
      return signedIn()
        && exists(teamPath(teamId))
        && get(teamPath(teamId)).data.memberUids.hasAny([request.auth.uid]);
    }

    function isAdmin(teamId) {
      return isApprovedMember(teamId) && memberDoc(teamId).data.role == 'admin';
    }

    function isTeamCreator(teamId) {
      return signedIn()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
    }

    function isInitialTeamCreator(teamId) {
      return signedIn()
        && getAfter(teamPath(teamId)).data.createdBy == request.auth.uid
        && ((getAfter(teamPath(teamId)).data.securitySchemaVersion == 1
            && getAfter(teamPath(teamId)).data.securityMigrationState == 'locked')
          || (getAfter(teamPath(teamId)).data.securitySchemaVersion == 2
            && getAfter(teamPath(teamId)).data.securityMigrationState == 'ready'));
    }

    function canManageTeam(teamId) {
      return isAdmin(teamId) || isTeamCreator(teamId);
    }

    function teamDoc(teamId) {
      return get(teamPath(teamId));
    }

    function hasTeamSetting(teamId, key) {
      return exists(teamPath(teamId))
        && teamDoc(teamId).data.keys().hasAll(['settings'])
        && teamDoc(teamId).data.settings.keys().hasAll([key]);
    }

    function teamSettingEquals(teamId, key, value) {
      return hasTeamSetting(teamId, key)
        && teamDoc(teamId).data.settings[key] == value;
    }

    function isSecurityReady(teamId) {
      return exists(teamPath(teamId))
        && teamDoc(teamId).data.keys().hasAll(['securitySchemaVersion', 'securityMigrationState'])
        && teamDoc(teamId).data.securitySchemaVersion == 2
        && teamDoc(teamId).data.securityMigrationState == 'ready';
    }

    function isMigrationInProgress(teamId) {
      return exists(teamPath(teamId))
        && teamDoc(teamId).data.keys().hasAll(['securityMigrationState'])
        && teamDoc(teamId).data.securityMigrationState == 'migrating';
    }

    function canReadReadyWorkspace(teamId) {
      return (canManageTeam(teamId) && !isMigrationInProgress(teamId))
        || (isSecurityReady(teamId) && isApprovedMember(teamId));
    }

    function canWriteReadyWorkspace(teamId) {
      return canWriteTeamData() && canReadReadyWorkspace(teamId);
    }

    function canReadMemberEmail(teamId, uid) {
      return canManageTeam(teamId)
        || (isSecurityReady(teamId) && isApprovedMember(teamId)
          && (isSelf(uid) || teamSettingEquals(teamId, 'memberEmailVisibility', 'all_members')));
    }

    function canReadMemberNote(teamId, uid) {
      return canManageTeam(teamId)
        || (isSecurityReady(teamId) && isApprovedMember(teamId)
          && (isSelf(uid) || teamSettingEquals(teamId, 'memberNoteVisibility', 'all_members')));
    }

    function canReadRewardTotal(teamId) {
      return canManageTeam(teamId)
        || (isSecurityReady(teamId) && isApprovedMember(teamId)
          && (teamSettingEquals(teamId, 'rewardVisibility', 'self_plus_total')
            || teamSettingEquals(teamId, 'rewardVisibility', 'all')));
    }

    function canReadRewardShare(teamId, uid) {
      return canManageTeam(teamId)
        || (isSecurityReady(teamId) && isApprovedMember(teamId)
          && (isSelf(uid) || teamSettingEquals(teamId, 'rewardVisibility', 'all')));
    }

    function canReadProjectCost(teamId) {
      return canManageTeam(teamId);
    }

    function canAssignProjects(teamId) {
      return canManageTeam(teamId)
        || (isSecurityReady(teamId) && isApprovedMember(teamId)
          && teamSettingEquals(teamId, 'assignPermission', 'owner_set')
          && hasTeamSetting(teamId, 'assignOwnerUids')
          && teamDoc(teamId).data.settings.assignOwnerUids.hasAny([request.auth.uid]));
    }

    function canDeleteProjects(teamId) {
      return canManageTeam(teamId)
        || (isSecurityReady(teamId) && isApprovedMember(teamId)
          && teamSettingEquals(teamId, 'deletePermission', 'all_edit'));
    }

    function validPayout(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'payoutName', 'payoutAccount', 'payoutBankCode',
          'payoutBankName', 'payoutBranchName', 'payoutBranchCode',
          'payoutAccountType', 'payoutAccountNumber', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isPublicMemberRecord(data, uid) {
      return data.keys().hasOnly([
          'uid', 'role', 'status', 'displayName', 'photoURL',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.uid == uid
        && data.role in ['admin', 'member']
        && data.status in ['active', 'pending', 'blocked'];
    }

    function isPublicProjectRecord(data, projectId, teamId) {
      return data.keys().hasOnly([
          'id', 'accountId', 'teamId', 'scope', 'contractType',
          'repeatParentId', 'repeatClosedAt', 'status', 'name',
          'shootDate', 'draftAt', 'deadline', 'deliveredAt', 'completedAt',
          'platforms', 'instructions', 'tags', 'mapUrl', 'assignedUids',
          'createdAt', 'updatedAt', 'updatedBy', 'revision',
          'deletedAt', 'deletedBy', 'schemaVersion'
        ])
        && data.id == projectId
        && data.teamId == teamId
        && data.scope == 'team'
        && data.schemaVersion == 2;
    }

    function isPublicAccountRecord(data, accountId, teamId) {
      return data.keys().hasOnly([
          'id', 'teamId', 'scope', 'username', 'url', 'memo', 'newDM', 'folderId',
          'createdAt', 'updatedAt', 'updatedBy', 'revision',
          'deletedAt', 'deletedBy', 'schemaVersion'
        ])
        && data.id == accountId
        && data.teamId == teamId
        && data.scope == 'team'
        && data.schemaVersion == 2;
    }

    function isPublicFolderRecord(data, folderId, teamId) {
      return data.keys().hasOnly([
          'id', 'teamId', 'scope', 'name', 'color', 'parentId', 'order', 'collapsed',
          'createdAt', 'updatedAt', 'updatedBy', 'revision',
          'deletedAt', 'deletedBy', 'schemaVersion'
        ])
        && data.id == folderId
        && data.teamId == teamId
        && data.scope == 'team'
        && data.schemaVersion == 2;
    }

    function isPublicTemplateRecord(data, templateId, teamId) {
      return data.keys().hasOnly([
          'id', 'teamId', 'scope', 'title', 'body',
          'createdAt', 'updatedAt', 'updatedBy', 'revision',
          'deletedAt', 'deletedBy', 'schemaVersion'
        ])
        && data.id == templateId
        && data.teamId == teamId
        && data.scope == 'team'
        && data.schemaVersion == 2;
    }

    function isPublicWorkspaceSettings(data, settingId, teamId) {
      return data.keys().hasOnly([
          'id', 'teamId', 'scope', 'hideDoneProjectsInList',
          'hideRepeatClosedProjectsInRepeatList', 'revenueBasis',
          'createdAt', 'updatedAt', 'updatedBy', 'revision', 'schemaVersion'
        ])
        && settingId == 'main'
        && data.id == settingId
        && data.teamId == teamId
        && data.scope == 'team'
        && data.schemaVersion == 2;
    }

    function isAuthenticatedUpdate(data) {
      return data.updatedBy == request.auth.uid;
    }

    function isMonotonicVersionedUpdate() {
      return request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt >= resource.data.updatedAt;
    }

    function isPersonalVersionedCreate() {
      return request.resource.data.revision == 1
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isPersonalVersionedUpdate() {
      let previousRevision = resource.data.keys().hasAll(['revision']) ? resource.data.revision : 0;
      let previousUpdatedAt = resource.data.keys().hasAll(['updatedAt']) ? resource.data.updatedAt : 0;
      return request.resource.data.revision == previousRevision + 1
        && request.resource.data.updatedAt >= previousUpdatedAt
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function canReadPayout(teamId, uid) {
      return canManageTeam(teamId)
        || (isSecurityReady(teamId) && isApprovedMember(teamId)
          && (isSelf(uid) || teamSettingEquals(teamId, 'memberPayoutVisibility', 'all_members')));
    }

    function isAllowedProjectUpdate(teamId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let deletes = resource.data.deletedAt == null && request.resource.data.deletedAt != null;
      let restores = resource.data.deletedAt != null && request.resource.data.deletedAt == null;
      return request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && (!changed.hasAny(['assignedUids']) || canAssignProjects(teamId))
        && (!changed.hasAny(['deletedAt', 'deletedBy'])
          || (deletes
            && canDeleteProjects(teamId)
            && request.resource.data.deletedAt is timestamp
            && request.resource.data.deletedBy == request.auth.uid)
          || (restores
            && canDeleteProjects(teamId)
            && resource.data.deletedBy == request.auth.uid
            && request.resource.data.deletedBy == null
            && request.time <= resource.data.deletedAt + duration.value(6, 's')));
    }

    function isProjectActivityAction(action) {
      return action in ['createProject', 'markDelivered', 'markCompleted', 'deleteProject'];
    }

    function hasActorOnlyActivityIdentity(data) {
      return data.identityUids is list
        && data.identityUids.size() == 1
        && data.identityUids[0] == data.actorUid;
    }

    function isValidProjectActivity() {
      return isProjectActivityAction(request.resource.data.action)
        && request.resource.data.keys().hasOnly([
          'action', 'text', 'coreText', 'actorUid', 'actorName',
          'targetName', 'projectId', 'identityUids', 'createdAt'
        ])
        && hasActorOnlyActivityIdentity(request.resource.data)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0
        && request.resource.data.actorName.size() <= 80
        && request.resource.data.targetName is string
        && request.resource.data.targetName.size() > 0
        && request.resource.data.targetName.size() <= 120
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && request.resource.data.projectId.size() <= 120
        && request.resource.data.coreText is string
        && request.resource.data.coreText.size() <= 240
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 320
        && request.resource.data.createdAt == request.time;
    }

    function isValidLegacyActivity(teamId) {
      return request.resource.data.keys().hasOnly([
          'action', 'text', 'coreText', 'actorUid', 'actorName',
          'targetUid', 'memberUid', 'targetName', 'identityUids', 'createdAt'
        ])
        && request.resource.data.action in ['createTeam', 'joinTeam', 'leaveTeam', 'removeMember']
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.action == 'joinTeam'
            && canManageTeam(teamId)
            && request.resource.data.keys().hasAll(['memberUid'])
            && request.resource.data.memberUid == request.resource.data.actorUid
            && hasActorOnlyActivityIdentity(request.resource.data))
          || (request.resource.data.action == 'removeMember'
            && canManageTeam(teamId)
            && request.resource.data.keys().hasAll(['targetUid'])
            && request.resource.data.targetUid != request.resource.data.actorUid
            && request.resource.data.identityUids is list
            && request.resource.data.identityUids.size() == 2
            && request.resource.data.actorUid in request.resource.data.identityUids
            && request.resource.data.targetUid in request.resource.data.identityUids)
          || (request.resource.data.action in ['createTeam', 'leaveTeam']
            && request.resource.data.actorUid == request.auth.uid
            && hasActorOnlyActivityIdentity(request.resource.data)));
    }

    function isValidOperationReceipt(operationId) {
      return request.resource.data.keys().hasOnly(['operationId', 'actorUid', 'createdAt'])
        && request.resource.data.operationId == operationId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    function isSafeSelfMemberUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'email',
        'payoutName',
        'payoutAccount',
        'payoutBankCode',
        'payoutBankName',
        'payoutBranchName',
        'payoutBranchCode',
        'payoutAccountType',
        'payoutAccountNumber',
        'note',
        'updatedAt',
        'updatedBy',
      ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /accountDeletionJobs/{jobId} {
      allow read, write: if false;
    }

    match /accountDeletionLocks/{uid} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && isDeletionUnlocked(uid);
      allow delete: if false;

      match /folders/{folderId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && isDeletionUnlocked(uid) && isPersonalVersionedCreate();
        allow update: if isSelf(uid) && isDeletionUnlocked(uid) && isPersonalVersionedUpdate();
        allow delete: if false;
      }

      match /accounts/{accountId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && isDeletionUnlocked(uid) && isPersonalVersionedCreate();
        allow update: if isSelf(uid) && isDeletionUnlocked(uid) && isPersonalVersionedUpdate();
        allow delete: if false;
      }

      match /projects/{projectId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && isDeletionUnlocked(uid) && isPersonalVersionedCreate();
        allow update: if isSelf(uid) && isDeletionUnlocked(uid) && isPersonalVersionedUpdate();
        allow delete: if false;
      }

      match /templates/{templateId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && isDeletionUnlocked(uid) && isPersonalVersionedCreate();
        allow update: if isSelf(uid) && isDeletionUnlocked(uid) && isPersonalVersionedUpdate();
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && isDeletionUnlocked(uid) && isPersonalVersionedCreate();
        allow update: if isSelf(uid) && isDeletionUnlocked(uid) && isPersonalVersionedUpdate();
        allow delete: if false;
      }
    }

    match /teamInviteCodes/{code} {
      allow get: if signedIn() && resource.data.disabledAt == null;
      allow list: if false;
      allow create: if signedIn()
        && canWriteTeamData()
        && hasUnlockedIdentity(request.resource.data)
        && isValidTeamInviteCodeCreate()
        && request.resource.data.code == code
        && request.resource.data.teamId is string
        && request.resource.data.inviteId is string
        && request.resource.data.createdBy == request.auth.uid
        && canManageTeam(request.resource.data.teamId);
      allow update: if signedIn()
        && canWriteTeamData()
        && hasUnlockedIdentity(request.resource.data)
        && isValidTeamInviteCodeCreate()
        && request.resource.data.code == code
        && request.resource.data.teamId is string
        && request.resource.data.inviteId is string
        && request.resource.data.createdBy == request.auth.uid
        && canManageTeam(request.resource.data.teamId);
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow create: if signedIn()
        && canWriteTeamData()
        && hasUnlockedIdentity(request.resource.data)
        && initialTeamIdentityIsValid(teamId, request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.deletedAt == null
        && ((request.resource.data.securitySchemaVersion == 1
            && request.resource.data.securityMigrationState == 'locked')
          || (request.resource.data.securitySchemaVersion == 2
            && request.resource.data.securityMigrationState == 'ready'
            && request.resource.data.memberUids.size() == 1
            && request.resource.data.memberUids.hasAny([request.auth.uid])
            && getAfter(memberPath(teamId, request.auth.uid)).data.uid == request.auth.uid
            && getAfter(memberPath(teamId, request.auth.uid)).data.role == 'admin'
            && getAfter(memberPath(teamId, request.auth.uid)).data.status == 'active'))
        && request.resource.data.settings.rewardVisibility == 'self'
        && request.resource.data.settings.memberEmailVisibility == 'admin_only'
        && request.resource.data.settings.memberNoteVisibility == 'admin_only'
        && request.resource.data.settings.memberPayoutVisibility == 'admin_only'
        && request.resource.data.settings.assignPermission == 'admin_only'
        && request.resource.data.settings.assignOwnerUids.size() == 0
        && request.resource.data.settings.deletePermission == 'admin_only';
      allow read: if (signedIn() && resource.data.memberUids.hasAny([request.auth.uid])) || isApprovedMember(teamId) || isTeamCreator(teamId);
      allow update: if canWriteTeamData()
        && canManageTeam(teamId)
        && hasUnlockedIdentity(request.resource.data)
        && stableTeamOwners()
        && teamRootUidArraysAreStable()
        && isValidTeamMemberUidUpdate(teamId)
        && embeddedSettingsUidsAreMembers(request.resource.data);
      allow delete: if false;

      match /members/{uid} {
        allow get: if canManageTeam(teamId)
          || (isApprovedMember(teamId) && isSelf(uid))
          || (isApprovedMember(teamId) && isSecurityReady(teamId) && isPublicMemberRecord(resource.data, uid));
        allow list: if canManageTeam(teamId)
          || (isSecurityReady(teamId) && isApprovedMember(teamId));
        allow create: if canWriteTeamData() && isDeletionUnlocked(uid) && ((canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canManageTeam(teamId) && isSecurityReady(teamId)
            && isPublicMemberRecord(request.resource.data, uid)
            && isAuthenticatedUpdate(request.resource.data))
          || (signedIn()
            && uid == request.auth.uid
            && isInitialTeamCreator(teamId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'active'
            && isPublicMemberRecord(request.resource.data, uid)
            && isAuthenticatedUpdate(request.resource.data)));
        allow update: if canWriteTeamData() && isDeletionUnlocked(uid) && ((canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canManageTeam(teamId) && isSecurityReady(teamId)
            && isPublicMemberRecord(request.resource.data, uid)
            && isAuthenticatedUpdate(request.resource.data))
          || (isSecurityReady(teamId) && isApprovedMember(teamId) && isSelf(uid)
            && isPublicMemberRecord(request.resource.data, uid)
            && isAuthenticatedUpdate(request.resource.data)
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status));
        allow delete: if canWriteTeamData() && !isMigrationInProgress(teamId)
          && (canManageTeam(teamId)
            || (isSelf(uid) && resource.data.role != 'admin'));
      }

      // 振込先(機微情報)は本人・管理者、またはチーム設定で公開された承認済みメンバーだけ読める
      match /payouts/{uid} {
        allow read: if canReadPayout(teamId, uid);
        allow create, update: if canWriteTeamData() && isDeletionUnlocked(uid) && !isMigrationInProgress(teamId)
          && (canManageTeam(teamId)
            || (isSecurityReady(teamId) && isApprovedMember(teamId) && isSelf(uid)))
          && validPayout(uid);
        allow delete: if canWriteTeamData() && !isMigrationInProgress(teamId)
          && (canManageTeam(teamId)
            || (isSecurityReady(teamId) && isApprovedMember(teamId) && isSelf(uid)));
      }

      // Private profile fields are intentionally separate from public member docs.
      match /memberEmails/{uid} {
        allow read: if canReadMemberEmail(teamId, uid);
        allow create, update: if canWriteTeamData() && isDeletionUnlocked(uid) && ((canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canManageTeam(teamId) && isSecurityReady(teamId)
            && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt', 'updatedBy'])
            && request.resource.data.uid == uid
            && request.resource.data.updatedBy == request.auth.uid)
          || (isInitialTeamCreator(teamId) && isSelf(uid)
            && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt', 'updatedBy'])
            && request.resource.data.uid == uid
            && request.resource.data.updatedBy == request.auth.uid)
          || (isSecurityReady(teamId) && isApprovedMember(teamId) && isSelf(uid)
            && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt', 'updatedBy'])
            && request.resource.data.uid == uid
            && request.resource.data.updatedBy == request.auth.uid));
        allow delete: if canWriteTeamData() && !isMigrationInProgress(teamId)
          && (canManageTeam(teamId)
            || (isSecurityReady(teamId) && isApprovedMember(teamId) && isSelf(uid)));
      }

      match /memberNotes/{uid} {
        allow read: if canReadMemberNote(teamId, uid);
        allow create, update: if canWriteTeamData() && isDeletionUnlocked(uid) && ((canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canManageTeam(teamId) && isSecurityReady(teamId)
            && request.resource.data.keys().hasOnly(['uid', 'note', 'createdAt', 'updatedAt', 'updatedBy'])
            && request.resource.data.uid == uid
            && request.resource.data.updatedBy == request.auth.uid)
          || (isSecurityReady(teamId) && isApprovedMember(teamId) && isSelf(uid)
            && request.resource.data.keys().hasOnly(['uid', 'note', 'createdAt', 'updatedAt', 'updatedBy'])
            && request.resource.data.uid == uid
            && request.resource.data.updatedBy == request.auth.uid));
        allow delete: if canWriteTeamData() && !isMigrationInProgress(teamId)
          && (canManageTeam(teamId)
            || (isSecurityReady(teamId) && isApprovedMember(teamId) && isSelf(uid)));
      }

      match /folders/{folderId} {
        allow get: if canManageTeam(teamId)
          || (isSecurityReady(teamId) && isApprovedMember(teamId)
            && isPublicFolderRecord(resource.data, folderId, teamId));
        allow list: if canManageTeam(teamId)
          || (isSecurityReady(teamId) && isApprovedMember(teamId));
        allow create: if ((canWriteTeamData() && canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canWriteReadyWorkspace(teamId)
            && isPublicFolderRecord(request.resource.data, folderId, teamId)
            && isAuthenticatedUpdate(request.resource.data)))
          && childIdentityIsValid(teamId, request.resource.data);
        allow update: if ((canWriteTeamData() && canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canWriteReadyWorkspace(teamId)
            && isPublicFolderRecord(request.resource.data, folderId, teamId)
            && isAuthenticatedUpdate(request.resource.data)
            && isMonotonicVersionedUpdate()))
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /accounts/{accountId} {
        allow get: if canManageTeam(teamId)
          || (isSecurityReady(teamId) && isApprovedMember(teamId)
            && isPublicAccountRecord(resource.data, accountId, teamId));
        allow list: if canManageTeam(teamId)
          || (isSecurityReady(teamId) && isApprovedMember(teamId));
        allow create: if ((canWriteTeamData() && canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canWriteReadyWorkspace(teamId)
            && isPublicAccountRecord(request.resource.data, accountId, teamId)
            && isAuthenticatedUpdate(request.resource.data)))
          && childIdentityIsValid(teamId, request.resource.data);
        allow update: if ((canWriteTeamData() && canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canWriteReadyWorkspace(teamId)
            && isPublicAccountRecord(request.resource.data, accountId, teamId)
            && isAuthenticatedUpdate(request.resource.data)
            && isMonotonicVersionedUpdate()
            && (!(resource.data.deletedAt == null && request.resource.data.deletedAt != null) || canDeleteProjects(teamId))
            && (!(resource.data.deletedAt != null && request.resource.data.deletedAt == null)
              || (canDeleteProjects(teamId)
                && resource.data.deletedBy == request.auth.uid
                && request.time <= resource.data.deletedAt + duration.value(6, 's')))))
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /projects/{projectId} {
        allow get: if canManageTeam(teamId)
          || (isSecurityReady(teamId) && isApprovedMember(teamId)
            && isPublicProjectRecord(resource.data, projectId, teamId));
        allow list: if canManageTeam(teamId)
          || (isSecurityReady(teamId) && isApprovedMember(teamId));
        allow create: if ((canWriteTeamData() && canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId)
            && childIdentityIsValid(teamId, request.resource.data))
          || (canWriteReadyWorkspace(teamId)
            && isPublicProjectRecord(request.resource.data, projectId, teamId)
            && isAuthenticatedUpdate(request.resource.data)
            && request.resource.data.revision == 1
            && (request.resource.data.assignedUids.size() == 0 || canAssignProjects(teamId))))
          && projectAssigneesAreMembers(teamId, request.resource.data);
        allow update: if ((canWriteTeamData() && canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId)
            && childIdentityIsValid(teamId, request.resource.data))
          || (canWriteReadyWorkspace(teamId)
            && isPublicProjectRecord(request.resource.data, projectId, teamId)
            && isAuthenticatedUpdate(request.resource.data)
            && isAllowedProjectUpdate(teamId)))
          && projectAssigneesAreMembers(teamId, request.resource.data);
        allow delete: if false;
      }

      match /projectRewardTotals/{projectId} {
        allow read: if canReadRewardTotal(teamId);
        allow create, update: if canWriteTeamData() && canManageTeam(teamId)
          && childIdentityIsValid(teamId, request.resource.data)
          && !isMigrationInProgress(teamId)
          && request.resource.data.keys().hasOnly(['projectId', 'totalYen', 'createdAt', 'updatedAt', 'updatedBy'])
          && request.resource.data.projectId == projectId
          && request.resource.data.totalYen is number
          && request.resource.data.totalYen >= 0
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

      match /projectRewardShares/{shareId} {
        allow read: if canReadRewardShare(teamId, resource.data.memberUid);
        allow create, update: if canWriteTeamData() && canManageTeam(teamId)
          && isDeletionUnlocked(request.resource.data.memberUid)
          && !isMigrationInProgress(teamId)
          && request.resource.data.keys().hasOnly([
            'projectId', 'memberUid', 'amountYen', 'assigned',
            'createdAt', 'updatedAt', 'updatedBy'
          ])
          && shareId == request.resource.data.projectId + '_' + request.resource.data.memberUid
          && request.resource.data.amountYen is number
          && request.resource.data.amountYen >= 0
          && request.resource.data.assigned is bool
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

      match /projectCosts/{projectId} {
        allow read: if canReadProjectCost(teamId);
        allow create, update: if canWriteTeamData() && canManageTeam(teamId)
          && childIdentityIsValid(teamId, request.resource.data)
          && !isMigrationInProgress(teamId)
          && request.resource.data.keys().hasOnly([
            'projectId', 'costYen', 'expenses', 'createdAt', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.projectId == projectId
          && request.resource.data.costYen is number
          && request.resource.data.costYen >= 0
          && request.resource.data.expenses is list
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

      match /templates/{templateId} {
        allow get: if canManageTeam(teamId)
          || (isSecurityReady(teamId) && isApprovedMember(teamId)
            && isPublicTemplateRecord(resource.data, templateId, teamId));
        allow list: if canManageTeam(teamId)
          || (isSecurityReady(teamId) && isApprovedMember(teamId));
        allow create: if ((canWriteTeamData() && canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canWriteReadyWorkspace(teamId)
            && isPublicTemplateRecord(request.resource.data, templateId, teamId)
            && isAuthenticatedUpdate(request.resource.data)))
          && childIdentityIsValid(teamId, request.resource.data);
        allow update: if ((canWriteTeamData() && canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canWriteReadyWorkspace(teamId)
            && isPublicTemplateRecord(request.resource.data, templateId, teamId)
            && isAuthenticatedUpdate(request.resource.data)
            && isMonotonicVersionedUpdate()))
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow get: if canManageTeam(teamId)
          || (isSecurityReady(teamId) && isApprovedMember(teamId));
        allow create: if ((canWriteTeamData() && canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canWriteReadyWorkspace(teamId)
            && isPublicWorkspaceSettings(request.resource.data, settingId, teamId)
            && isAuthenticatedUpdate(request.resource.data)))
          && settingsUidArraysAreMembers(
            request.resource.data, getAfter(teamPath(teamId)).data.memberUids)
          && childIdentityIsValid(teamId, request.resource.data);
        allow update: if ((canWriteTeamData() && canManageTeam(teamId) && !isSecurityReady(teamId) && !isMigrationInProgress(teamId))
          || (canWriteReadyWorkspace(teamId)
            && isPublicWorkspaceSettings(request.resource.data, settingId, teamId)
            && isAuthenticatedUpdate(request.resource.data)
            && isMonotonicVersionedUpdate()))
          && settingsUidArraysAreMembers(
            request.resource.data, getAfter(teamPath(teamId)).data.memberUids)
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /activity/{activityId} {
        allow read: if isApprovedMember(teamId) || isTeamCreator(teamId);
        allow create: if canWriteTeamData() && canReadReadyWorkspace(teamId)
          && (isValidProjectActivity() || isValidLegacyActivity(teamId))
          && childIdentityIsValid(teamId, request.resource.data);
        allow update, delete: if false;
      }

      match /operations/{operationId} {
        allow read: if isApprovedMember(teamId) || isTeamCreator(teamId);
        allow create: if canWriteTeamData() && canReadReadyWorkspace(teamId)
          && isValidOperationReceipt(operationId)
          && childIdentityIsValid(teamId, request.resource.data);
        allow update, delete: if false;
      }

      match /invites/{inviteId} {
        allow read: if canManageTeam(teamId);
        allow create, update: if canWriteTeamData() && canManageTeam(teamId)
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }

      match /joinRequests/{requestId} {
        allow create: if signedIn()
          && isDeletionUnlocked(request.auth.uid)
          && isValidJoinRequestCreate()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && exists(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId))
          && get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId)).data.disabledAt == null;
        allow read: if canManageTeam(teamId) || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if canWriteTeamData() && canManageTeam(teamId)
          && childIdentityIsValid(teamId, request.resource.data);
        allow delete: if false;
      }
    }

    // collectionGroup query support: allow user to read their own joinRequests across teams
    match /{path=**}/joinRequests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // collectionGroup query support: allow user to find their own membership docs
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
